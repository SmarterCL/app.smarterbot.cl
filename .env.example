# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Demo Mode (Set to false for production)
NEXT_PUBLIC_DEMO_MODE=false

# FastAPI Backend
FASTAPI_URL=https://api.smarterbot.cl

# Mailgun Configuration
MAILGUN_API_KEY=your-mailgun-key-here
NEXT_PUBLIC_MAILGUN_KEY=your-mailgun-key-here

# Flow Configuration
FLOW_API_KEY=your-flow-key-here
FLOW_SECRET_KEY=your-flow-secret-here

# Note: Add your actual values before deploying to Vercel