# Environment Variables Template for SmarterBot.cl
# Copy this file to .env.local and fill in your actual values

# ===========================================
# Supabase Configuration (Required)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Demo Mode (Set to false for production)
NEXT_PUBLIC_DEMO_MODE=false

# ===========================================
# Clerk Authentication (Required)
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
CLERK_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===========================================
# SmarterMCP Integration (Optional)
# ===========================================
SMARTERMCP_ACCESS_TOKEN=your-smartermcp-access-token-here
SMARTERMCP_SERVER_URL=https://api.smartermcp.com

# ===========================================
# JWT & Database (Required for some features)
# ===========================================
JWT_SECRET_KEY=your-jwt-secret-key-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ===========================================
# Mailgun Configuration (Required for emails)
# ===========================================
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_API_DOMAIN=smarterbot.store
FROM_EMAIL=noreply@smarterbot.cl
TO_EMAIL=hola@smarterbot.cl

# ===========================================
# Flow Configuration (Required for payments)
# ===========================================
FLOW_API_KEY=your-flow-api-key-here
FLOW_SECRET_KEY=your-flow-secret-key-here

# ===========================================
# Chatwoot Integration (Optional)
# ===========================================
CHATWOOT_BASE_URL=your-chatwoot-url
CHATWOOT_ACCOUNT_ID=your-account-id
CHATWOOT_ACCESS_TOKEN=your-chatwoot-access-token

# ===========================================
# Google AI / Gemini (Optional)
# ===========================================
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
# Optional: Specify preferred model
GOOGLE_AI_MODEL=gemini-2.0-pro

# ===========================================
# N8N Automation (Optional)
# ===========================================
N8N_API_KEY=your-n8n-api-key-here
N8N_BOOTSTRAP_WEBHOOK_URL=https://n8n.smarterbot.cl/webhook/bootstrap-tenant

# ===========================================
# SmarterOS API Integration (Optional)
# ===========================================
SMARTEROS_API_URL=https://api.smarterbot.cl
SMARTEROS_API_KEY=your-smarteros-api-key-here

# ===========================================
# Azure Integration (Optional)
# ===========================================
VAULT_ADDR=https://vault.smarterbot.cl
VAULT_TOKEN=your-vault-token-here

# Note: Add your actual values before deploying to Vercel
# NEVER commit .env or .env.local files with real credentials
