{
    "security": {
        "tokens": {
            "smartermcp_access_token": "USE_ENV_VAR_SMARTERMCP_ACCESS_TOKEN",
            "jwt_secret": "USE_ENV_VAR_JWT_SECRET"
        },
        "domains": [
            "rut.smarterbot.store",
            "app.smarterbot.cl",
            "crm.smarterbot.cl"
        ],
        "protocols": {
            "force_https": true,
            "cors_origins": [
                "https://rut.smarterbot.store",
                "https://app.smarterbot.cl",
                "https://crm.smarterbot.cl"
            ]
        },
        "validation": {
            "token_expiry_days": 90,
            "rotation_enabled": true
        }
    }
}